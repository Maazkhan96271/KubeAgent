# ---------------------------------------------------------------------------
# KubeAgent configuration template
# Copy to .env and fill in the values you need: cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=KubeAgent
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_PREFIX=/api/v1

# --- Server / CORS ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                   # CRITICAL | ERROR | WARNING | INFO | DEBUG
UVICORN_LOG_LEVEL=info
ACCESS_LOG=true

# --- Agent safety ----------------------------------------------------------
# true = never touch a real cluster, use the built-in demo scenario.
SIMULATION_MODE=true
AGENT_MAX_STEPS=6
AUTO_REMEDIATE=false

# --- LLM provider (DeepSeek or any OpenAI-compatible endpoint) -------------
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45

# --- Kubernetes ------------------------------------------------------------
# Leave empty to use in-cluster credentials, then ~/.kube/config.
KUBECONFIG_PATH=
KUBE_CONTEXT=
WATCH_NAMESPACES=default,kube-system
K8S_TIMEOUT_SECONDS=10

# --- Notifications ---------------------------------------------------------
SLACK_WEBHOOK_URL=
